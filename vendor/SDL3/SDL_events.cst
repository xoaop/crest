    reserved: u32;
    //  In nanoseconds, populated using SDL_GetTicksNS()
    timestamp: u64;
    //  The window with mouse focus, if any
    windowID: SDL_WindowID;
    //  The pen instance id
    which: SDL_PenID;
    //  Complete pen input state at time of event
    pen_state: SDL_PenInputFlags;
    //  X coordinate, relative to window
    x: f32;
    //  Y coordinate, relative to window
    y: f32;
    //  The pen button index (first button is 1).
    button: u8;
    //  true if the button is pressed
    down: bool;
}
//  Pressure-sensitive pen pressure / angle event structure (event.paxis.*) You might get some of
//   these events even if the pen isn't touching the tablet.
//
//  \since This struct is available since SDL 3.2.0.
SDL_PenAxisEvent :: struct {
    //  SDL_EVENT_PEN_AXIS
    type: SDL_EventType;
    reserved: u32;
    //  In nanoseconds, populated using SDL_GetTicksNS()
    timestamp: u64;
    //  The window with pen focus, if any
    windowID: SDL_WindowID;
    //  The pen instance id
    which: SDL_PenID;
    //  Complete pen input state at time of event
    pen_state: SDL_PenInputFlags;
    //  X coordinate, relative to window
    x: f32;
    //  Y coordinate, relative to window
    y: f32;
    //  Axis that has changed
    axis: SDL_PenAxis;
    //  New value of axis
    value: f32;
}
//  An event used to drop text or request a file open by the system (event.drop.*)
//
//  \since This struct is available since SDL 3.2.0.
SDL_DropEvent :: struct {
    //  SDL_EVENT_DROP_BEGIN or SDL_EVENT_DROP_FILE or SDL_EVENT_DROP_TEXT or SDL_EVENT_DROP_COMPLETE or
    //   SDL_EVENT_DROP_POSITION
    type: SDL_EventType;
    reserved: u32;
    //  In nanoseconds, populated using SDL_GetTicksNS()
    timestamp: u64;
    //  The window that was dropped on, if any
    windowID: SDL_WindowID;
    //  X coordinate, relative to window (not on begin)
    x: f32;
    //  Y coordinate, relative to window (not on begin)
    y: f32;
    //  The source app that sent this drop event, or NULL if that isn't available
    source: *u8;
    //  The text for SDL_EVENT_DROP_TEXT and the file name for SDL_EVENT_DROP_FILE, NULL for other
    //   events
    data: *u8;
}
//  An event triggered when the clipboard contents have changed (event.clipboard.*)
//
//  \since This struct is available since SDL 3.2.0.
SDL_ClipboardEvent :: struct {
    //  SDL_EVENT_CLIPBOARD_UPDATE
    type: SDL_EventType;
    reserved: u32;
    //  In nanoseconds, populated using SDL_GetTicksNS()
    timestamp: u64;
    //  are we owning the clipboard (internal update)
    owner: bool;
    //  number of mime types
    num_mime_types: i32;
    //  current mime types
    mime_types: **u8;
}
//  Sensor event structure (event.sensor.*)
//
//  \since This struct is available since SDL 3.2.0.
SDL_SensorEvent :: struct {
    //  SDL_EVENT_SENSOR_UPDATE
    type: SDL_EventType;
    reserved: u32;
    //  In nanoseconds, populated using SDL_GetTicksNS()
    timestamp: u64;
    //  The instance ID of the sensor
    which: SDL_SensorID;
    //  Up to 6 values from the sensor - additional values can be queried using SDL_GetSensorData()
    data: [6]f32;
    //  The timestamp of the sensor reading in nanoseconds, not necessarily synchronized with the system
    //   clock
    sensor_timestamp: u64;
}
//  The "quit requested" event
//
//  \since This struct is available since SDL 3.2.0.
SDL_QuitEvent :: struct {
    //  SDL_EVENT_QUIT
    type: SDL_EventType;
    reserved: u32;
    //  In nanoseconds, populated using SDL_GetTicksNS()
    timestamp: u64;
}
//  A user-defined event type (event.user.*) This event is unique; it is never created by SDL, but
//   only by the application. The event can be pushed onto the event queue using SDL_PushEvent().
//   The contents of the structure members are completely up to the programmer; the only requirement
//   is that '''type''' is a value obtained from SDL_RegisterEvents().
//
//  \since This struct is available since SDL 3.2.0.
SDL_UserEvent :: struct {
    //  SDL_EVENT_USER through SDL_EVENT_LAST, Uint32 because these are not in the SDL_EventType
    //   enumeration
    type: u32;
    reserved: u32;
    //  In nanoseconds, populated using SDL_GetTicksNS()
    timestamp: u64;
    //  The associated window if any
    windowID: SDL_WindowID;
    //  User defined event code
    code: i32;
    //  User defined data pointer
    data1: *void;
    //  User defined data pointer
    data2: *void;
}
//  The structure for all events in SDL. The SDL_Event structure is the core of all event handling
//   in SDL. SDL_Event is a union of all event structures used in SDL.
//
//  \since This struct is available since SDL 3.2.0.
SDL_Event :: union {
    //  Event type, shared with all events, Uint32 to cover user events which are not in the
    //   SDL_EventType enumeration
    type: u32;
    //  Common event data
    common: SDL_CommonEvent;
    //  Display event data
    display: SDL_DisplayEvent;
    //  Window event data
    window: SDL_WindowEvent;
    //  Keyboard device change event data
    kdevice: SDL_KeyboardDeviceEvent;
    //  Keyboard event data
    key: SDL_KeyboardEvent;
    //  Text editing event data
    edit: SDL_TextEditingEvent;
    //  Text editing candidates event data
    edit_candidates: SDL_TextEditingCandidatesEvent;
    //  Text input event data
    text: SDL_TextInputEvent;
    //  Mouse device change event data
    mdevice: SDL_MouseDeviceEvent;
    //  Mouse motion event data
    motion: SDL_MouseMotionEvent;
    //  Mouse button event data
    button: SDL_MouseButtonEvent;
    //  Mouse wheel event data
    wheel: SDL_MouseWheelEvent;
    //  Joystick device change event data
    jdevice: SDL_JoyDeviceEvent;
    //  Joystick axis event data
    jaxis: SDL_JoyAxisEvent;
    //  Joystick ball event data
    jball: SDL_JoyBallEvent;
    //  Joystick hat event data
    jhat: SDL_JoyHatEvent;
    //  Joystick button event data
    jbutton: SDL_JoyButtonEvent;
    //  Joystick battery event data
    jbattery: SDL_JoyBatteryEvent;
    //  Gamepad device event data
    gdevice: SDL_GamepadDeviceEvent;
    //  Gamepad axis event data
    gaxis: SDL_GamepadAxisEvent;
    //  Gamepad button event data
    gbutton: SDL_GamepadButtonEvent;
    //  Gamepad touchpad event data
    gtouchpad: SDL_GamepadTouchpadEvent;
    //  Gamepad sensor event data
    gsensor: SDL_GamepadSensorEvent;
    //  Audio device event data
    adevice: SDL_AudioDeviceEvent;
    //  Camera device event data
    cdevice: SDL_CameraDeviceEvent;
    //  Sensor event data
    sensor: SDL_SensorEvent;
    //  Quit request event data
    quit: SDL_QuitEvent;
    //  Custom event data
    user: SDL_UserEvent;
    //  Touch finger event data
    tfinger: SDL_TouchFingerEvent;
    //  Pinch event data
    pinch: SDL_PinchFingerEvent;
    //  Pen proximity event data
    pproximity: SDL_PenProximityEvent;
    //  Pen tip touching event data
    ptouch: SDL_PenTouchEvent;
    //  Pen motion event data
    pmotion: SDL_PenMotionEvent;
    //  Pen button event data
    pbutton: SDL_PenButtonEvent;
    //  Pen axis event data
    paxis: SDL_PenAxisEvent;
    //  Render event data
    render: SDL_RenderEvent;
    //  Drag and drop event data
    drop: SDL_DropEvent;
    //  Clipboard event data
    clipboard: SDL_ClipboardEvent;
    padding: [128]u8;
}
SDL_EventAction :: i32
SDL_EventType :: i32

