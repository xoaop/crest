//
//  \param ncolors — represents the number of color entries in the color palette.
//
//  \returns a new SDL_Palette structure on success or NULL on failure (e.g. if there wasn't enough
//   memory); call SDL_GetError() for more information.
//
//  \since This function is available since SDL 3.2.0.
//
//  \sa SDL_DestroyPalette, SDL_SetPaletteColors, SDL_SetSurfacePalette
