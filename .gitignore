# 编译产物
*.exe
*.dll
*.exp
*.pdb
*.ilk
*.o
*.obj
*.ll
*.bc
*.out
*.so

# LLVM-C 库 dll（Windows 运行时依赖，入库）
!bin/LLVM-C.dll
!bin/libLLVM.so.21.1

# 临时文件
*.tmp
temp*
.ninja_log

# Windows 批处理脚本：构建入口要入库，其余忽略
*.bat
!build.bat
!test.bat
!fuzz.bat

# 构建输出目录
output/
build/
build_release/
.build/
build_cmake_*/
build_rel_*/
build_ubsan*/

# IDE配置
.vscode/
.VSCodeCounter/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters

# 测试：源码要提交（含种子语料），构建产物与生成的 fuzz case 排除
test/build_test/
test/build_fuzz/
test/__pycache__/

# SDL3 示例/构建产物
build_sdl/
build_sdl_test/
build_sdl_test.*
*.log
