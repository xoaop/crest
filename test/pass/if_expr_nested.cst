// @pass
// @run

// else 后面接的是表达式，if ... then ... else ... 自己就是表达式，右嵌套

classify :: (a: i32) -> i32 {
    return if a == 0 then 1 else if a == 1 then 2 else 3;
}

main :: () -> i32 {
    if classify(0) != 1 { return 1; }
    if classify(1) != 2 { return 2; }
    if classify(9) != 3 { return 3; }
    return 0;
}
