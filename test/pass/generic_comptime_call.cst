// @skip
// @pass
// @run

// $T 泛型函数在编译期被调用: 顶层 const 求值。
// 实例化(外层调用)与函数体求值(内层调用)是两个实例, 形参类型算在外层那个里,
// 内层靠 creator 链回落过去
add :: (a: $T, b: T) -> T {

    return a + b;
}

SUM_I32 :: add(3i32, 4i32)
SUM_I64 :: add(10i64, 20i64)
SUM_F64 :: add(1.5f64, 2.5f64)

main :: () -> i32 {

    if SUM_I32 != 7i32 { return 1; }
    if SUM_I64 != 30i64 { return 2; }
    if SUM_F64 != 4.0f64 { return 3; }

    // 同一实例的编译期调用与运行期调用并存
    if add(1i32, 2i32) != 3i32 { return 4; }

    return 0;
}
