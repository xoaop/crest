// @pass
// @run

S :: struct { x: i32; }

value_before_defer :: () -> S {
    s := S.{ x = 3 };
    defer s.x = 9;
    return s;
}

ct_return :: $() -> i32 {
    x := 3;
    defer x = 9;
    return x;
}

ct_nested :: $() -> i32 {
    x := 1;
    {
        defer x = x + 2;
        {
            defer x = x * 3;
        }
    }
    return x;
}

inner_loop :: () -> i32 {
    x := 0;
    {
        defer {
            for n in 0..4 {
                if n == 0 { continue; }
                x = x + n;
                if n == 2 { break; }
            }
        }
    }
    return x;
}

ct_early :: $() -> i32 {
    x := 0;
    if true {
        defer {
            if x != 0 { compile_error("defer 执行了两次"); }
            x = x + 1;
        }
        return 0;
    }
    return 1;
}

ct_conditional :: $(take: bool) -> i32 {
    x := 0;
    defer {
        if x != 0 { compile_error("外层 defer 执行了两次"); }
        x = x + 1;
    }
    if take { return 0; }
    return 1;
}

main :: () -> i32 {
    if ct_conditional(true) != 0 { return 6; }
    if ct_conditional(false) != 1 { return 7; }
    if ct_early() != 0 { return 5; }
    if ct_return() != 3 { return 1; }
    if ct_nested() != 5 { return 2; }
    if inner_loop() != 3 { return 3; }
    if value_before_defer().x != 3 { return 4; }
    return 0;
}
