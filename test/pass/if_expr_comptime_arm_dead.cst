// @pass
// @run

// 编译期条件：只分析活臂，死臂没有结果，外层类型仍要能下发（不能去读死臂的类型）
pick :: $(n: i32) -> i32 {
    y: i32 = if n > 0 then 1 else if n > -1 then 2 else 3;
    return y;
}

main :: () -> i32 {
    if pick(1) != 1 { return 1; }
    if pick(0) != 2 { return 2; }
    if pick(-2) != 3 { return 3; }
    return 0;
}
