// @skip
// 生成器显式类型参数 $(T: type)，非裸 $T 推断体系；本次"单独 $T"目标不含。
// 待生成器专项再启用。
add :: $(T: type) -> ? {
    return (a: T, b: T) -> T {
        return a + b;
    };
}

SUM :: add(i32)(3i32, 4i32)

main :: () -> i32 {

    if SUM != 7i32 { return 1; }

    // 运行期调用同一批实例
    if add(i32)(1i32, 2i32) != 3i32 { return 2; }
    if add(i64)(10i64, 20i64) != 30i64 { return 3; }

    return 0;
}
