// @pass
// @run

// 位运算：| & ^ ~ << >>
// 优先级按 C：<< >> 高于 & 高于 ^ 高于 | 高于 && 高于 ||
// 结果类型是操作数类型（不是 bool）；有符号右移用算术移位

bit_or :: (a: i32, b: i32) -> i32 { return a | b; }

main :: () -> i32 {
    // 常量折叠
    if (3 | 5) != 7 { return 1; }
    if (6 & 3) != 2 { return 2; }
    if (6 ^ 3) != 5 { return 3; }
    if (1 << 4) != 16 { return 4; }
    if (32 >> 2) != 8 { return 5; }

    // 按位取反：按位宽，有符号做符号扩展
    if ~0i32 != -1 { return 6; }
    if ~0u8 != 255 { return 7; }
    if ~0u32 != 4294967295 { return 8; }

    // 运行时值
    a: u32 = 0xF0;
    b: u32 = 0x0F;
    if (a | b) != 0xFF { return 10; }
    if (a & b) != 0 { return 11; }
    if (a ^ b) != 0xFF { return 12; }
    if (a << 4) != 0xF00 { return 13; }
    if (a >> 4) != 0xF { return 14; }

    // 有符号右移是算术移位（补符号位）
    s: i32 = -16;
    if (s >> 2) != -4 { return 15; }

    // 位掩码组合（SDL 风格的 flag 用法）
    f1: u64 = 0x20;                 // SDL_WINDOW_RESIZABLE
    f2: u64 = 0x2000;               // SDL_WINDOW_HIGH_PIXEL_DENSITY
    flags: u64 = f1 | f2;
    if flags != 0x2020 { return 16; }
    if (flags & f2) == 0 { return 17; }

    // 作函数参数与返回值
    if bit_or(1, 2) != 3 { return 18; }

    // 优先级：<< 高于 & 高于 ^ 高于 |
    if (1 << 2 & 4) != 4 { return 19; }        // (1<<2) & 4
    if (1 | 2 ^ 3) != 1 { return 20; }         // 1 | (2^3) = 1|1
    if (1 + 2 << 3) != 24 { return 21; }       // (1+2) << 3
    if (6 & 3 ^ 1) != 3 { return 22; }         // (6&3)^1 = 2^1 = 3
    return 0;
}
