// @pass
// @run

#under_is_file_scope
trace: i32 = 0;
record :: (digit: i32) -> void {
    trace = trace * 10 + digit;
    return;
}

normal :: () -> void {
    defer record(1);
    defer record(2);
    {
        defer record(3);
        record(4);
    }
    record(5);
    return;
}

early :: (take: bool) -> i32 {
    defer record(1);
    if take {
        defer record(2);
        return 7;
    }
    return 8;
}

local_value :: () -> i32 {
    x := 3;
    defer x = 9;
    return x;
}

loops :: () -> void {
    defer record(9);
    for n in 0..3 {
        defer record(1);
        if n == 0 { continue; }
        {
            defer record(2);
            if n == 1 { continue; }
            break;
        }
    }
    return;
}

nested :: () -> void {
    defer {
        n := 3;
        defer record(4);
        record(n);
    }
    record(2);
    return;
}

ct :: $(n: i32) -> i32 {
    x := n;
    {
        defer x = x + 4;
        x = x + 1;
    }
    return x;
}

main :: () -> i32 {
    normal();
    if trace != 43521 { return 1; }
    trace = 0;
    if early(true) != 7 { return 2; }
    if trace != 21 { return 3; }
    trace = 0;
    if early(false) != 8 { return 4; }
    if trace != 1 { return 5; }
    if local_value() != 3 { return 6; }
    trace = 0;
    loops();
    if trace != 121219 { return 7; }
    trace = 0;
    nested();
    if trace != 234 { return 8; }
    if ct(2) != 7 { return 9; }
    return 0;
}
