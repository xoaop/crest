// @pass
// @run

// 同类型实参必须复用同一个泛型实例: FuncCallKey 按实参"类型"去重, 而非按实参指令身份。
// 若按指令身份, 每个调用点都会开一个新实例, LLVM 也会生成多份同签名函数。
add :: (a: $T, b: T) -> T {

    return a + b;
}

main :: () -> i32 {

    // 三个调用点, 实参指令各不相同, 但类型都是 i32 → 同一实例
    r1 := add(1i32, 2i32);
    r2 := add(10i32, 20i32);
    r3 := add(100i32, 200i32);

    if r1 != 3i32 { return 1; }
    if r2 != 30i32 { return 2; }
    if r3 != 300i32 { return 3; }

    // 换类型 → 另一个实例, 与上面互不干扰
    f1 := add(1.5f64, 2.5f64);
    if f1 != 4.0f64 { return 4; }

    // 再回到 i32, 仍复用第一个实例
    r4 := add(7i32, 8i32);
    if r4 != 15i32 { return 5; }

    return 0;
}
