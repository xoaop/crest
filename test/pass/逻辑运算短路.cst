// @pass
// @run

// ── 编译期：死分支右侧常量不被 eager 求值（能编译过即证明，10/0 若被求值会报错）──
dead_and :: () -> bool { return false && (10/0 == 0); }
dead_or  :: () -> bool { return true  || (10/0 == 0); }

// ── 运行时：bump() 通过指针写入计数器，观测右侧是否真的执行（跨平台，不依赖 glibc rand 序列）──
bump :: (p: *i32) -> i32 { ^p = ^p + 1; return ^p; }

rhs_skipped_and :: (p: *i32) -> bool { return false && (bump(p) == 12345); }  // 死分支：不调用 bump
rhs_skipped_or  :: (p: *i32) -> bool { return true  || (bump(p) == 12345); }  // 死分支：不调用 bump
rhs_ran_and     :: (p: *i32) -> bool { return true  && (bump(p) == 12345); }  // 活分支：bump → cnt 递增
rhs_ran_or      :: (p: *i32) -> bool { return false || (bump(p) == 12345); }  // 活分支：bump → cnt 递增

// ── 短路值语义：左侧已知时，右侧是否参与求值 ──
l_and_f :: (x: bool) -> bool { return false && x; }
l_and_t :: (x: bool) -> bool { return true && x; }
l_or_t  :: (x: bool) -> bool { return true  || x; }
l_or_f  :: (x: bool) -> bool { return false || x; }

main :: () -> i32 {
    if dead_and() != false { return 1; }
    if dead_or()  != true  { return 2; }

    // 死分支右侧未执行 → bump 不调用，cnt 保持 0
    cnt := 0;
    if rhs_skipped_and(&cnt) != false { return 3; }
    if rhs_skipped_or(&cnt)  != true  { return 4; }
    if cnt != 0 { return 5; }

    // 活分支右侧必须执行 → 每次 bump 让 cnt 递增
    if rhs_ran_and(&cnt) != false { return 6; }
    if cnt != 1 { return 7; }
    if rhs_ran_or(&cnt) != false { return 8; }
    if cnt != 2 { return 9; }

    if l_and_f(true)  != false { return 10; }
    if l_and_t(false) != false { return 11; }
    if l_or_t(false)  != true  { return 12; }
    if l_or_f(true)   != true  { return 13; }

    return 0;
}
