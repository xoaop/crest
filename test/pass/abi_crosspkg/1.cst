// @pass
// @run

// 跨包 ABI：结构体 sret 返回、byval 传参、i64 返回、结构体经运行期 if 汇合、跨包函数指针
import "foo"

locadd :: (x: i32) -> i32 { return x + 100; }

pick :: (c: bool) -> foo.Vec {
    return if c then foo.make_vec(1, 2) else foo.make_vec(3, 4);
}

main :: () -> i32 {
    v := foo.make_vec(3, 4);
    if v.x != 3 { return 1; }
    if v.y != 4 { return 2; }

    if foo.vec_sum(foo.Vec.{5, 6}) != 11 { return 3; }

    r := foo.ret_i64(0);
    if r != 1 { return 4; }

    if pick(true).x != 1 { return 5; }
    if pick(false).x != 3 { return 6; }

    c := true;
    f := if c then &foo.add1 else &locadd;
    if f(10) != 11 { return 7; }

    c = false;
    f = if c then &foo.add1 else &locadd;
    if f(10) != 110 { return 8; }

    return 0;
}
