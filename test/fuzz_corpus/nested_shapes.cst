// fuzz corpus seed: 深嵌套与各种括号形状
// 这些文件是 fuzz mutate_* recipe 的输入基底：结构密度高，让字节/token
// 级变异容易落在有意义的位置上。

P0 :: **i32
P1 :: ***i32
P2 :: ******i32

A0 :: [2][3]i32
A1 :: [4][4][4]i32

Nested :: struct {
    inner: struct {
        deeper: struct {
            x: i32;
        };
    };
}

Deep :: struct {
    p: ***i32;
    a: [2][2]i32;
    n: Nested;
}

make_deep :: () -> Deep {
    d: Deep;
    d.n.inner.deeper.x = 1;
    return d;
}

main :: () -> i32 {
    x := ((((((1))))));
    y := ((((1))))  + ((((2))));
    d := make_deep();
    return x + y + d.n.inner.deeper.x;
}
